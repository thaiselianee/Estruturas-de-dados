using System;

public class Node {
    public int Key { get; set; }
    public Node Left { get; set; }
    public Node Right { get; set; }

    public Node(int key) {
        Key = key;
    }
}

public class BST{ //DECLARA UMA class O INICIO

private Node root; //root seira tipo um no 
public void Insert(int value){
    root = InsertRecursive(root, value);
}
    private Node InsertRecursive(Node current, int value){
        if(current == null){
            return new Node(value);
        }
        if (value < current.Key){ // se o valor a inserir for menor q o no atual vai pra esquerda
         current.Left = InsertRecursive(current.Left, value);   
        }
        else if(value > current.Key){
            current.Right = InsertRecursive(current.Right, value);
        }
        return current;
    }
    
    //metodo buscar (SEARCH)
    public Node Buscar(int value){
        return BuscarRecursivo(root, value);
        
    }
    
    private Node BuscarRecursivo(Node current, int value){
        //current e o no atual "raiz e value e o valor q queremos encontrar"
        if(current == null || current.Key == value){ 
            //se o valor "current" = null CHEGOU NO FINAL E N ACHOU
            //current == value ENCONTROU 
             return current;// E O NO ENCONTRADO OU NAO ACHOU
        }
        
        if(value < current.Key){
            //nesse casso ele busca de um lado e depois do outro se n achar 
            //EX: SE O VALOR FPOR MENOR , ENTAO ELE SO PODE ESTAR NA esquerda
            return BuscarRecursivo(current.Left, value); 
        }
        else {
            return BuscarRecursivo(current.Right, value);
        }
        
        
    }
    //MINIMO tentativa
     public Node Minimo() {
        return MinimoRec(root);
    }

    private Node MinimoRec(Node current) {
        if (current == null)
            return null;

        if (current.Left == null)
            return current;

        return MinimoRec(current.Left);
    }
    
    
     public Node Maximo() {
        return MaximoRec(root);
    }

    private Node MaximoRec(Node current) {
        if (current == null)
            return null;

        if (current.Right == null)
            return current;

        return MaximoRec(current.Right);
    }

    
      public void PrintInOrder() {
        PrintInOrderRec(root);
        Console.WriteLine();
    }

    private void PrintInOrderRec(Node current) {
        if (current != null) {
            PrintInOrderRec(current.Left);
            Console.Write(current.Key + " ");
            PrintInOrderRec(current.Right);
        }
    }
    
    
    //
    
    
      // COOL PRINT (RECURSIVO) TESTE
    public void CoolPrint() {
        CoolPrintRec(root, 0);
    }

    private void CoolPrintRec(Node current, int space) {
        if (current == null)
            return;

        space += 5;

        CoolPrintRec(current.Right, space);

        Console.WriteLine();
        for (int i = 5; i < space; i++)
            Console.Write(" ");

        Console.WriteLine(current.Key);

        CoolPrintRec(current.Left, space);
    }
}

// MAIN
public class Program {
    public static void Main(string[] args) {
        BST bst = new BST();

        bst.Insert(15);
        bst.Insert(10);
        bst.Insert(8);
        bst.Insert(12);
        bst.Insert(20);
        bst.Insert(21);

        Console.WriteLine("In-order:");
        bst.PrintInOrder();

        Console.WriteLine("Minimo: " + bst.Minimo().Key);
        Console.WriteLine("Maximo: " + bst.Maximo().Key);

        Console.WriteLine("\nVisualização:");
        bst.CoolPrint();
    }
}
   